{
  "name": "gridlabs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "snap": "dotenv -e .env.local -- cross-env vite build && dotenv -e .env.local -- cross-env concurrently -k \"vite preview --port 4175\" \"wait-on http://localhost:4175 && node scripts/flexible-snapshot.js\"",
    "diff": "dotenv -e .env.local -- node scripts/diff-snapshots.js",
    "pr-comment": "dotenv -e .env.local -- node scripts/pr-comment-bot.js",
    "webhook": "dotenv -e .env.local -- node scripts/webhook-notifier.js",
    "relic-scan": "node scripts/relic-scanner.js",
    "ci:phase-e": "npm run diff && npm run relic-scan && npm run pr-comment && npm run webhook",
    "test-slack": "dotenv -e .env.local -- node -e \"const fetch = require('node-fetch'); fetch(process.env.SLACK_WEBHOOK_URL, {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({text: 'GridLabs webhook test 🚀'})}).then(r => console.log(r.ok ? '🟥 Slack notification sent!' : '🟤 Error: ' + r.status))\"",
    "typecheck": "tsc -p tsconfig.node.json",
    "build:node": "tsc -p tsconfig.node.json --emitDeclarationOnly false"
  },
  "dependencies": {
    "@chakra-ui/react": "^2.8.2",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@fastify/jwt": "^9.1.0",
    "@fastify/rate-limit": "^10.2.2",
    "@types/archiver": "^6.0.3",
    "@types/node-fetch": "^2.6.12",
    "archiver": "^7.0.1",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "fastify": "^5.3.2",
    "framer-motion": "^10.16.4",
    "lucide-react": "^0.292.0",
    "nock": "^14.0.4",
    "ora": "^8.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.18.0"
  },
  "devDependencies": {
    "@google-cloud/storage": "^7.16.0",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.0.0",
    "@types/node": "^20.9.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitejs/plugin-react": "^4.1.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^8.0.0",
    "eslint": "^8.53.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "fast-glob": "^3.3.2",
    "jsdom": "^22.1.0",
    "node-fetch": "^2.7.0",
    "playwright": "^1.52.0",
    "prettier": "^3.0.3",
    "sharp": "^0.32.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2",
    "vite": "^5.0.0",
    "vitest": "^0.34.6",
    "wait-on": "^7.2.0"
  }
}
