{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "target": "ES2020",
    "outDir": "./dist-node",
    "allowJs": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "plugins",
    "api/**/*",
    "packages/cli/**/*",
    "cloudflare/**/*"
  ]
}